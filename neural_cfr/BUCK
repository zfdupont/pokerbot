cxx_library(
    name = "core",
    srcs = glob(["src/**/*.cpp"], exclude = ["src/bindings/bindings.cpp"]),
    headers = glob(["src/**/*.h"]),
    header_namespace = "",
    compiler_flags = ["-std=c++17", "-O2"],
    exported_preprocessor_flags = ["-Ineural_cfr/src"],
    deps = ["//third_party:libtorch", "//third_party:indicators", "//common:evaluator"],
    preferred_linkage = "static",
    visibility = ["PUBLIC"],
)

# Python include path is machine-specific. Set [python] include_path in
# .buckconfig.local (gitignored, never commit). Get the correct value with:
#   python3 -c "import sysconfig; print(sysconfig.get_path('include'))"
# Then add to .buckconfig.local:
#   [python]
#     include_path = /path/to/python/include
_python_include = read_config("python", "include_path", "")

cxx_library(
    name = "neural_cfr",
    srcs = ["src/bindings/bindings.cpp"],
    headers = [],
    header_namespace = "",
    compiler_flags = [
        "-std=c++17",
        "-O2",
    ] + (["-I" + _python_include] if _python_include else []),
    deps = [":core", "//third_party:pybind11", "//third_party:libtorch"],
    preferred_linkage = "shared",
    soname = "neural_cfr.so",
    # On macOS, Python extension modules must defer libpython symbol resolution
    # to the Python runtime (which is already loaded at import time).
    linker_flags = ["-undefined", "dynamic_lookup"],
    visibility = ["PUBLIC"],
)
