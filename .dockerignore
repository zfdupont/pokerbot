# Build context is the repo root (Makefile + .github/workflows pass "."), so
# Docker only ever reads this file — docker/.dockerignore is NOT applied.

# Large vendored deps not needed to build sixmax (only needed for neural_cfr)
third_party/libtorch/

# Build artifacts
buck-out/
**/__pycache__/
**/*.pyc

# Checkpoints + generated lookup tables (large, don't belong in build context)
sixmax/checkpoints/
sixmax/tables/
neural_cfr/checkpoints/
cfr/checkpoints/

# Git
.git/

# Dev / local files
.env
.venv/
*.local
